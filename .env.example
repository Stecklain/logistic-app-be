PORT=3000

# PostgreSQL nativo (no Docker). Se recomienda un rol dedicado al proyecto,
# por ejemplo: CREATE ROLE logistic_app WITH LOGIN PASSWORD 'logistic_app' CREATEDB;
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logistic_db
DB_USER=logistic_app
DB_PASSWORD=logistic_app

# Base de test: separada por nombre, mismo servidor Postgres (puerto 5432).
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=logistic_db_test
TEST_DB_USER=logistic_app
TEST_DB_PASSWORD=logistic_app

JWT_SECRET=cambia_esto_por_un_secreto_seguro
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
ORS_API_KEY=coloca_tu_api_key
ORS_USE_MOCK=false

# Backup automático (pg_dump) cada 12hs mientras el servidor está corriendo.
# Poner en false para desactivarlo (ej. en una máquina de desarrollo).
BACKUP_ENABLED=true
