{
  "name": "logistic-app-be",
  "version": "1.0.0",
  "description": "Backend de logística con TDD, PostgreSQL y OpenRouteService",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "dev:test": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev:db:up": "node ./scripts/manage-database.mjs create dev",
    "dev:db:down": "node ./scripts/manage-database.mjs drop dev",
    "migrate": "ts-node src/scripts/run-migrations.ts",
    "seed:test": "ts-node src/scripts/seed-test-data.ts",
    "seed:bulk": "ts-node src/scripts/seed-bulk-pedidos.ts",
    "backup": "ts-node src/scripts/backup-database.ts",
    "backup:restore": "ts-node src/scripts/restore-database.ts",
    "test": "mocha --require ts-node/register --require test/setup.ts --extension ts \"test/**/*.spec.ts\"",
    "test:db:up": "node ./scripts/manage-database.mjs create test",
    "test:db:down": "node ./scripts/manage-database.mjs drop test",
    "test:db:migrate": "ts-node src/scripts/run-migrations.ts --env test",
    "test:full": "npm run test:db:up && npm run test:db:migrate && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stecklain/logistic-app-be.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.29",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/chai": "^4.3.20",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.8.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "chai": "^4.5.0",
    "mocha": "^11.7.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
